{
  "name": "frontier-war-mcp",
  "version": "1.0.0",
  "description": "辺境星系戦記をAIエージェントに遊ばせるためのMCPサーバー（Playwright経由でブラウザを操作）",
  "type": "module",
  "main": "server.mjs",
  "bin": { "frontier-war-mcp": "server.mjs" },
  "scripts": {
    "start": "node server.mjs",
    "http": "node server.mjs --http 3939",
    "test": "node selftest.mjs",
    "test:notes": "node notes-test.mjs",
    "test:regress": "node regress.mjs",
    "play": "node ai-player.mjs",
    "noa": "node ai-player.mjs",
    "ui": "node control.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright": "1.56.1",
    "zod": "^3.25.76"
  }
}
